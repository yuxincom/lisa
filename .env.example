# ---- LISA 生产环境变量 ----
# 复制为 .env 后修改；.env 不得提交到版本库。

# 必填：JWT 签名密钥，使用 32 字节以上随机值
JWT_SECRET=replace-with-a-long-random-secret

# 数据库连接（可选；不配置则使用 backend/data/lisa.db）
# 格式：postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# 密码含 @ : / # % 等字符时必须做 URL 百分号编码（如 @ 写成 %40）
# 示例：postgresql+psycopg2://postgres:change%40me@10.0.0.12:5432/lisa
DATABASE_URL=

# 首次启动是否写入演示数据（1=写入，0=不写入）
# 连接已有数据的库或生产正式启用时请置 0，避免重复灌入演示数据
LISA_SEED=1

# 对外端口（可选，默认 8000）
LISA_PORT=8000

# 基础镜像（可选）。服务器直连 Docker Hub 超时时，改成可用镜像站的全路径，例如：
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
NODE_IMAGE=node:22-alpine
PYTHON_IMAGE=python:3.12-slim

# 依赖下载源（可选，留空用官方源）。构建卡在 npm ci / pip install 时改成国内源：
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
NPM_REGISTRY=
PIP_INDEX_URL=

# 仅在同源反代未覆盖时按需配置，多个来源使用英文逗号分隔
CORS_ORIGINS=http://localhost:8000

# 初始账号密码（首次初始化数据库时生效，留空则使用内置演示密码）
# 生产环境务必全部覆盖，并在首次登录后纳入统一身份认证。
LISA_PASSWORD_ADMIN=
LISA_PASSWORD_COMMANDER=
LISA_PASSWORD_PLANNER=
LISA_PASSWORD_DISPATCHER=
LISA_PASSWORD_ENGINEER=
LISA_PASSWORD_EXPERT=

# ---- 主数据接入通道（P0-5）----
# 齐套九要素里「未接入」的要素来自 ERP/MES/质量等外部系统。
# 界面与设置里只写变量名，真实凭据只放这里；变量留空表示该通道未接通，
# LISA 会把对应齐套要素如实标为「未接入」，不会当成已满足或 0。
LISA_ERP_TOKEN=
# 只读直连源库的 DSN（LISA 只会执行 SELECT），例：
# postgresql+psycopg2://lisa_ro:read-only-pwd@10.0.0.21:5432/mes
LISA_MES_DSN=
# 内置轮询间隔（秒）。0 = 关闭进程内轮询，改由外部定时任务跑
# python -m app.management adapters --force
LISA_ADAPTER_POLL_SECONDS=0

# ---- 内网模型编排（P1-6）----
# 只允许内网 OpenAI 兼容端点（/chat/completions），且强制 https。
# 模型只做 ReAct 推理与只读工具选择，所有数字由 LISA 代码实算后回填；
# 未配置时自动降级为确定性编排，排产链路不受影响。
LISA_LLM_API_KEY=

# ---- 审计链外部锚点（P1-7）----
# 把审计哈希链的链尾按只追加的方式签到库外文件 data/audit_anchor.jsonl。
# 库内链只能证明「相邻两条没被改」，锚点文件是第二份独立证据：能改库也改不掉这里。
# 留空 = 锚定接口一律拒绝（不会写一个谁都能重算的假锚点）。
# 密钥本身只放这里；换成别的变量名时设 LISA_ANCHOR_SECRET_ENV=你的变量名。
LISA_ANCHOR_SECRET=
LISA_ANCHOR_SECRET_ENV=LISA_ANCHOR_SECRET

# ---- 后台任务队列（P2-9）----
# 排产编排、外部数据拉取都在数据库任务队列里跑：POST /api/agents/run 立刻返回 202。
# 多副本部署时只让一个副本当工人，其余置 0（它们照样能入队、查状态、取消排队中的任务）。
LISA_JOB_WORKER=1
# 工人轮询间隔（秒）与排障用的工人编号；留空则自动取「主机名:进程号」
LISA_JOB_POLL_SECONDS=1.5
LISA_WORKER_ID=

# ---- 整库快照与恢复（P2-9）----
# 快照目录（容器里建议放在 lisa-data 卷上）与保留份数，超出的按时间从旧到新清理
LISA_BACKUP_DIR=
LISA_BACKUP_KEEP=14
