# ---- LISA 生产环境变量 ----
# 复制为 .env 后修改；.env 不得提交到版本库。

# 必填：JWT 签名密钥，使用 32 字节以上随机值
JWT_SECRET=replace-with-a-long-random-secret

# 数据库连接（可选；不配置则使用 backend/data/lisa.db）
# PostgreSQL 示例：postgresql+psycopg2://user:password@localhost:5432/lisa
DATABASE_URL=

# 对外端口（可选，默认 8000）
LISA_PORT=8000

# 仅在同源反代未覆盖时按需配置，多个来源使用英文逗号分隔
CORS_ORIGINS=http://localhost:8000

# 初始账号密码（首次初始化数据库时生效，留空则使用内置演示密码）
# 生产环境务必全部覆盖，并在首次登录后纳入统一身份认证。
LISA_PASSWORD_ADMIN=
LISA_PASSWORD_COMMANDER=
LISA_PASSWORD_PLANNER=
LISA_PASSWORD_DISPATCHER=
LISA_PASSWORD_ENGINEER=
LISA_PASSWORD_EXPERT=
